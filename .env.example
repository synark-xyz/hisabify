# Hisabify Environment Variables
# Copy this file to .env and fill in your values
# NOTE: In Lovable Cloud, these are auto-configured

# Supabase Configuration (auto-provided by Lovable Cloud)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Application Settings
# Production URL. Used for password-reset email links and OAuth redirects.
# For local dev, this can be left as-is; window.location.origin is used at runtime.
VITE_APP_URL=your_app_url
VITE_APP_URL_SCHEME=io.synark.hisabify
VITE_APP_NAME=your_app_name

# Error Tracking (optional - for production)
# Public DSN from Sentry > Settings > Client Keys. Never put an sntrys_ auth
# token here; that goes in .env.sentry-build-plugin as SENTRY_AUTH_TOKEN.
VITE_SENTRY_DSN=https://<publicKey>@o<orgId>.ingest.sentry.io/<projectId>
# Optional: tag events with a release for source-map matching.
VITE_SENTRY_RELEASE=

# In-App Purchases (RevenueCat) — no VITE_ vars: purchases are native-only.
# The SDK key comes from REVENUECAT_API_KEY_{DEBUG,STAGING,RELEASE} in local.properties
# or the environment (see android/app/build.gradle → BuildConfig.REVENUECAT_API_KEY,
# consumed by HisabifyApp.java). The entitlement id is ENTITLEMENT_ID in
# src/hooks/useRevenueCat.ts.

# App Store Links (used in web upgrade modal to direct users to mobile apps)
# On web, users cannot subscribe directly — they must download the mobile app
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=io.synark.hisabify
VITE_APP_STORE_URL=https://apps.apple.com/app/hisabify/idYOUR_APP_ID

# Feature Flags
VITE_ENABLE_ANALYTICS=true

# Gemini API Key (optional - for AI receipt scanning fallback)
# Get your API key from https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key

# AdMob (Android only — banner shown to free users)
# Banner ad unit ID from https://apps.admob.com → your app → Ad units
# Leave unset for development: the app falls back to Google's test ad unit whenever this is
# empty OR the build is not a production build. Serving real ads from a debug build risks
# suspension of your AdMob account.
# NOTE: the AdMob *application* ID is separate and is a native/Gradle value, not a Vite one.
# Release builds read it from ADMOB_APP_ID_RELEASE in android/local.properties (or the same
# environment variable); debug and staging always use Google's test app ID.
VITE_ADMOB_BANNER_ID=your_admob_banner_ad_unit_id

# Mindee V2 API (for receipt scanning - primary provider)
# Get your API key from https://platform.mindee.com → API Keys
# Get your model ID from your custom extraction model settings
VITE_MINDEE_API_KEY=your_mindee_api_key
VITE_MINDEE_MODEL_ID=your_mindee_model_id
