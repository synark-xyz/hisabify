# Copy this file to .env.test and fill in your values.
# .env.test is already in .gitignore — never commit it.

# --- E2E Test User Credentials ---
# Regular (free) test user
E2E_REGULAR_EMAIL=your-regular-user@email.com
E2E_REGULAR_PASSWORD=YourPassword123

# Pro (premium) test user
E2E_PRO_EMAIL=your-pro-user@email.com
E2E_PRO_PASSWORD=YourProPassword123

# --- Optional: override the E2E target URL ---
# Defaults: http://localhost:8080 (local dev), http://localhost:4173 (CI preview)
# E2E_BASE_URL=http://localhost:8080

# Note: VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are read from your
# existing .env file by the Vite dev/preview server. You do NOT need to
# duplicate them here unless you are running E2E in a standalone mode.
