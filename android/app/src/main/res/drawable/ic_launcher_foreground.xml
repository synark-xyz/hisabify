<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <!-- Full-bleed dark gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#00080C14"
                android:endColor="#000F1729"
                android:angle="135" />
        </shape>
    </item>

    <!-- Centered Hisabify logo at ~64dp -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <vector
            android:width="64dp"
            android:height="64dp"
            android:viewportWidth="1024"
            android:viewportHeight="1024">

            <!-- Group wrapper so AnimatedVectorDrawable can target the whole logo -->
            <group
                android:name="logo_group"
                android:pivotX="512"
                android:pivotY="512"
                android:scaleX="1"
                android:scaleY="1">

                <!-- Background circle with gradient -->
                <path
                    android:pathData="M512,20a492,492 0 1,1 0,984a492,492 0 1,1 0,-984">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="0"
                            android:startY="0"
                            android:endX="1024"
                            android:endY="1024">
                            <item android:offset="0" android:color="#3B82F6"/>
                            <item android:offset="0.5" android:color="#8B5CF6"/>
                            <item android:offset="1" android:color="#EC4899"/>
                        </gradient>
                    </aapt:attr>
                </path>

                <!-- Arc 1 -->
                <path
                    android:fillColor="#60A5FA"
                    android:fillAlpha="0.95"
                    android:pathData="M512,184
                    A328,328 0 0,1 774,312
                    L664,409
                    A184,184 0 0,0 512,328 Z"/>

                <!-- Arc 2 -->
                <path
                    android:fillColor="#A78BFA"
                    android:fillAlpha="0.95"
                    android:pathData="M774,312
                    A328,328 0 0,1 840,512
                    H696
                    A184,184 0 0,0 664,409 Z"/>

                <!-- Arc 3 -->
                <path
                    android:fillColor="#F472B6"
                    android:fillAlpha="0.95"
                    android:pathData="M840,512
                    A328,328 0 0,1 712,774
                    L623,664
                    A184,184 0 0,0 696,512 Z"/>

                <!-- Arc 4 -->
                <path
                    android:fillColor="#FCD34D"
                    android:fillAlpha="0.95"
                    android:pathData="M712,774
                    A328,328 0 0,1 512,840
                    V696
                    A184,184 0 0,0 623,664 Z"/>

                <!-- Inner white circle -->
                <path
                    android:fillColor="#FFFFFF"
                    android:fillAlpha="0.98"
                    android:pathData="M512,338
                    a174,174 0 1,1 0,348
                    a174,174 0 1,1 0,-348"/>

                <!-- Dollar symbol -->
                <path
                    android:pathData="M505,390
                    c-42,4 -74,32 -74,70
                    c0,34 26,55 72,65
                    c42,9 54,19 54,35
                    c0,19 -18,33 -44,33
                    c-27,0 -46,-12 -54,-31
                    l-43,18
                    c10,29 37,49 75,54
                    v42
                    h36
                    v-40
                    c46,-5 78,-33 78,-73
                    c0,-36 -22,-56 -70,-68
                    c-44,-11 -57,-19 -57,-34
                    c0,-17 15,-28 40,-28
                    c22,0 38,9 47,25
                    l40,-19
                    c-11,-25 -35,-42 -67,-46
                    v-40
                    h-36
                    Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="400"
                            android:startY="350"
                            android:endX="350"
                            android:endY="650">
                            <item android:offset="0" android:color="#60A5FA"/>
                            <item android:offset="0.3" android:color="#8B5CF6"/>
                            <item android:offset="0.6" android:color="#EC4899"/>
                            <item android:offset="1" android:color="#FCD34D"/>
                        </gradient>
                    </aapt:attr>
                </path>

            </group>

        </vector>
    </item>

</layer-list>
