<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Full-bleed dark gradient background (kept) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#080c14"
                android:endColor="#0f1729"
                android:angle="135" />
        </shape>
    </item>

    <!-- Soft radial glow behind the logo -->
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:useLevel="false" />
        </shape>
    </item>

    <!-- Subtle translucent ring (gives depth) -->
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center">
        <shape android:shape="oval">
            <size android:width="220dp" android:height="220dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0dp" android:color="#22FFFFFF" />
        </shape>
    </item>

    <!-- Centered launcher animated vector -->
    <item android:drawable="@drawable/avd_splash_logo" android:gravity="center" />

</layer-list>
