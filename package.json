{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "dev:managed": "node scripts/managed-dev-server.js",
    "dev:staging": "node scripts/ngrok-staging-server.js --port=8181",
    "dev:staging:ngrok": "node scripts/ngrok-staging-server.js --port=8181 --ngrok=true",
    "dev:staging:ngrok:hilton": "node scripts/ngrok-staging-server.js --port=8181 --ngrok=true --url=https://hilton-irate-jovita.ngrok-free.dev --mode=production",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:automated": "bash scripts/run-automated-tests.sh all",
    "test:automated:unit": "bash scripts/run-automated-tests.sh unit",
    "test:automated:e2e": "bash scripts/run-automated-tests.sh e2e",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:android": "npm run build && npx cap sync && npx cap open android",
    "cap:ios": "npm run build && npx cap sync && npx cap open ios",
    "cap:run:android": "npm run build && npx cap sync && npx cap run android",
    "cap:run:ios": "npm run build && npx cap sync && npx cap run ios",
    "cap:sync:staging": "APP_ENV=staging npx cap sync",
    "cap:sync:release": "APP_ENV=production npx cap sync",
    "cap:android:staging": "npm run build && APP_ENV=staging STAGING_URL=${STAGING_URL:-https://hisabify-pi.vercel.app} npx cap sync && npx cap open android",
    "cap:android:release": "npm run build && APP_ENV=production npx cap sync && npx cap open android",
    "dev:android": "npx cap run android",
    "dev:ios": "npx cap run ios",
    "local-ip": "node scripts/get-local-ip.js",
    "cap:dev:android": "npm run dev:managed & npx cap run android",
    "cap:dev:ios": "npm run dev:managed & npx cap run ios",
    "cap:dev:android:unmanaged": "npm run dev & npx cap run android",
    "cap:dev:ios:unmanaged": "npm run dev & npx cap run ios"
  },
