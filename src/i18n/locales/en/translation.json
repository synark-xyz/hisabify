  "deleteAccount": {
    "title": "Delete Your Account",
    "desc": "You can request deletion of your Hisabify account and all associated data at any time. This page explains how to do that and what happens to your data.",
    "method1": {
      "title": "Method 1 — Delete in the App (Recommended)",
      "desc": "Instant deletion of all your financial data",
      "step1": "Open the Hisabify app and sign in to your account.",
      "step2": "Tap your profile avatar in the top-right corner of the dashboard.",
      "step3": "Select Data & Privacy from the profile menu.",
      "step4": "Scroll to the Danger Zone section and tap Delete Data.",
      "step5": "Type DELETE in the confirmation box and tap Delete Data to confirm.",
      "note": "Your financial data is deleted immediately. You will be signed out automatically."
    },
    "method2": {
      "title": "Method 2 — Request via Email",
      "desc": "For full account removal including your login credentials",
      "step1": "Send an email to {{email}}",
      "step2": "Use the subject line: Account Deletion Request — Hisabify",
      "step3": "Include the email address associated with your Hisabify account in the message body.",
      "note": "We will process your request within 30 days and send a confirmation to your email once complete."
    },
